# =============================================================================
# VayuReader Backend — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ===================
# REQUIRED SETTINGS
# ===================

# PostgreSQL connection string (REQUIRED — server will not start without this)
POSTGRES_URI=postgresql://vayureader:vayureader@localhost:5432/vayureader

# PostgreSQL password (used by Docker Compose for the postgres container)
POSTGRES_PASSWORD=vayureader

# JWT Secret Key (REQUIRED — minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# OTP SMS Gateway URL (REQUIRED for OTP functionality)
OTP_GATEWAY_URL=http://msg.com:8080/smsc/sends

# ===================
# SERVER SETTINGS
# ===================

# Server port (default: 3000)
PORT=3000

# Environment mode (development | production)
NODE_ENV=development

# Number of cluster workers (default: number of CPU cores)
# CLUSTER_WORKERS=4

# ===================
# SECURITY BYPASS (Development Only)
# ===================
# Set to 'true' to disable E2EE encryption, DPoP proofs, and multipart
# E2EE signatures on BOTH backend and frontend. Useful for debugging
# API requests with tools like Postman, curl, or browser DevTools.
# IMPORTANT: Automatically blocked in production (NODE_ENV=production).
# For the admin dashboard, also set REACT_APP_SECURITY_BYPASS=true
SECURITY_BYPASS=false

# Testing mode — enables SameSite=None cookies for cross-origin testing.
# NEVER allowed in production.
TESTING=false

# ===================
# JWT SETTINGS
# ===================

# JWT token expiry in days (default: 1)
JWT_EXPIRY_DAYS=1

# JWT absolute lifetime in days (default: 36500 = ~100 years)
# JWT_LIFETIME_DAYS=36500

# ===================
# DPoP SETTINGS
# ===================
# (Overridden when SECURITY_BYPASS=true)

# Enable DPoP proof-of-possession (default: true)
# Set false only for emergency legacy compatibility
DPOP_ENABLED=true

# Allow query-param DPoP proofs for endpoints that cannot send headers
# (currently /api/events browser navigations)
DPOP_ALLOW_QUERY_PROOF=true

# One-time DPoP proof replay cache TTL in seconds (default: 120)
DPOP_PROOF_TTL_SECONDS=120

# Allowed iat clock skew window in seconds (default: 90)
DPOP_MAX_IAT_SKEW_SECONDS=90

# ===================
# OTP SETTINGS
# ===================

# OTP expiry in minutes (default: 5)
OTP_EXPIRY_MINUTES=5

# Max OTP verification attempts before lockout (default: 5)
OTP_MAX_ATTEMPTS=5

# Skip actual SMS sending in development (set to true for testing)
SKIP_OTP_SEND=true

# OTP-specific rate limit — max OTP requests per window (default: 5)
OTP_RATE_LIMIT_MAX=5

# ===================
# CORS SETTINGS
# ===================

# CORS allowed origins (comma-separated list)
# Leave empty to allow all in development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================
# RATE LIMITING
# ===================

# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window (default: 500)
RATE_LIMIT_MAX_REQUESTS=500

# ===================
# REDIS SETTINGS
# ===================

# Redis connection string (for OTP storage, sessions, DPoP replay cache)
REDIS_URL=redis://localhost:6379

# ===================
# ELASTICSEARCH SETTINGS
# ===================

# Elasticsearch URL (for search functionality)
ELASTICSEARCH_URL=http://localhost:9200

# ===================
# CLICKHOUSE SETTINGS (Log Analytics)
# ===================

# ClickHouse connection URL
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse database name
CLICKHOUSE_DATABASE=vayureader_logs

# ClickHouse user
CLICKHOUSE_USER=default

# ClickHouse password (empty by default)
CLICKHOUSE_PASSWORD=

# ===================
# POSTGRESQL SETTINGS (Advanced)
# ===================

# PostgreSQL pool size
PG_MAX_POOL_SIZE=50
PG_MIN_POOL_SIZE=5

# PostgreSQL SSL (production only — set to 'false' to disable)
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=true

# ===================
# PDF SECURITY SETTINGS
# ===================

# PDF security scan mode (default: strict)
# Options:
#   strict     — Block critical, high, and medium threats (RECOMMENDED)
#   moderate   — Block critical and high threats only
#   permissive — Block only critical threats (NOT RECOMMENDED)
#
# Threats detected:
#   JavaScript, OpenAction, Launch actions, Embedded files, XFA forms, Rich media
PDF_SECURITY_MODE=strict

# Maximum PDF upload size in MB (default: 100)
MAX_UPLOAD_SIZE_MB=100

# ===================
# SIGNED FILE URLS
# ===================

# HMAC secret for signed /uploads URLs (REQUIRED for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
FILE_URL_SECRET=your-super-secret-file-url-hmac

# Signed URL TTL in seconds (default: 60)
FILE_URL_TTL_SECONDS=60

# ===================
# ADMIN DASHBOARD (Frontend)
# ===================
# These are used by the admin dashboard's Docker entrypoint (docker-entrypoint.sh)
# and injected into the browser via window.__ENV__ at container startup.

# Backend API base URL for the admin dashboard
REACT_APP_API_BASE_URL=https://localhost

# Disable E2EE + DPoP on the admin dashboard (mirrors SECURITY_BYPASS for the frontend)
REACT_APP_SECURITY_BYPASS=false
ES_REFRESH_POLICY=wait_for

# ==================
# MINIO CREDENTIALS
# ==================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_password_here
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=india
MINIO_ACCESS_KEY=<key>
MINIO_SECRET_KEY=<secret>
MINIO_BUCKET=vayureader
MINIO_ENABLE=true
PUBLIC_MINIO_BASE=https://localhost/storage
